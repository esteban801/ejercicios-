#include <iostream>
using namespace std;

int main() {
    int a, b, c;
    cout << "Ingrese tres numeros enteros: ";
    cin >> a >> b >> c;

    if (a <= b && b <= c) {
        cout << "Los numeros estan ordenados de menor a mayor (ascendente)." << endl;
    } else if (a >= b && b >= c) {
        cout << "Los numeros estan ordenados de mayor a menor (descendente)." << endl;
    } else {
        cout << "Los numeros no estan en orden numerico." << endl;
    }

    return 0;
}
#include <iostream>
using namespace std;

bool esPrimo(int n) {
    if (n < 2) return false;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) return false;
    }
    return true;
}

bool esPotenciaDeDos(int n) {
    return (n > 0) && ((n & (n - 1)) == 0);
}

int main() {
    int num;
    cout << "Ingrese un numero entero: ";
    cin >> num;

    if (num < 0 || num >= 30) {
        cout << "El numero es negativo o es mayor/igual a 30." << endl;
    } else if (num == 0) {
        cout << "Cero" << endl;
    } else if (num == 1) {
        cout << "Unidad" << endl;
    } else {
        if (esPotenciaDeDos(num)) {
            cout << "El numero es una potencia de 2." << endl;
        } 
        
        if (esPrimo(num)) {
            cout << "El numero es un numero primo." << endl;
        } else {
            cout << "El numero es un numero compuesto." << endl;
        }
    }

    return 0;
}
